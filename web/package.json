{
  "name": "cadastre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "types": "wrangler types --include-runtime=false",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev --port 8787",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:types": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261025.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
