---
import Site from '../layouts/Site.astro';
import DocumentDiagram from '../components/DocumentDiagram.astro';
import publicCatalog from '../../public/data/catalog.json';
const stats = publicCatalog.stats;
---
<Site title="Cadastre — A source of reference." description="An open, source-traceable reference foundation for identity documents across the United States. Browse state and federal collections.">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> AN OPEN REFERENCE INITIATIVE BY KENSHIKI LABS</p><h1 id="hero-title">A source<br/>of <span>reference.</span></h1><p class="hero-intro">Document intelligence starts with knowing what you’re looking at.</p><p class="hero-description">A traceable reference foundation for identity documents across all 51 U.S. jurisdictions. Public sources. Open methods. Evidence you can inspect.</p><div class="hero-actions"><a class="button button-primary" href="/catalog">Explore the catalog <span aria-hidden="true">↗</span></a><a class="text-link" href="https://github.com/Kenshiki-Labs/state-id-harvester">View the code <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span class="open-mark" aria-hidden="true">↗</span><span>Open code & schemas.<br/><strong>Public reference images. No account required.</strong></span></div></div>
        <DocumentDiagram/>
      </section>
      <div class="stats-strip"><div class="shell stats-inner"><div><strong>{stats.jurisdictions}</strong><span>Jurisdictions in scope</span></div><div><strong>{stats.sources}</strong><span>Source publications collected</span></div><div><strong>{stats.jurisdictions_with_sources}</strong><span>Jurisdictions with sources</span></div><div><strong>{stats.accepted_cohorts}</strong><span>Accepted cohorts <i>Review pending</i></span></div></div></div>

<section class="shell section-space" aria-labelledby="explore-title"><div class="section-heading"><div><p class="eyebrow">EXPLORE CADASTRE</p><h2 id="explore-title">Find your reference.</h2></div><p>Browse a collection, inspect its sources, or learn how the research is built.</p></div><div class="entry-grid"><a class="entry-card" href="/catalog"><span class="eyebrow">51 JURISDICTIONS</span><h3>State references <span aria-hidden="true">↗</span></h3><p>Find a state or the District of Columbia, then open its dedicated reference page.</p></a><a class="entry-card" href="/catalog/federal"><span class="eyebrow">FEDERAL COLLECTION</span><h3>Federal references <span aria-hidden="true">↗</span></h3><p>Explore federal credential publications, reference images, and documented gaps.</p></a><a class="entry-card" href="/method"><span class="eyebrow">OPEN RESEARCH</span><h3>Our method <span aria-hidden="true">↗</span></h3><p>How public sources, native extraction, provenance, and review become a reference.</p></a></div></section>
</Site>
