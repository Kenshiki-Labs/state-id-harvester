{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kenshiki-cadastre",
  "account_id": "45c6882cb63b0ec680263ca4649fe848",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "cadastre.kenshikilabs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://cadastre.kenshikilabs.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadastre-access",
      "database_id": "86560a7f-3f29-4e68-bbed-f5d9527ee842",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT",
      "bucket_name": "cadastre-specimens"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_READ_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
